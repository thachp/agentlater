{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runlater-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  // Better Auth needs Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs: request logs and exceptions, searchable in the dashboard. Inherited by each env.
  "observability": { "enabled": true },
  // Secrets, passed with `--secrets-file` at deploy from the GitHub environment (docs/DEPLOY.md):
  //   ASSERTION_PRIVATE_KEY  hex 32-byte Ed25519 seed; the API's GATEWAY_PUBLIC_KEY is its public key
  //   BETTER_AUTH_SECRET     32+ random bytes
  // A2A_ENABLED "true" serves the A2A Agent Card and /a2a (src/a2a.ts); anything else answers 404 for both.
  "vars": { "PUBLIC_URL": "http://localhost:8787", "A2A_ENABLED": "true" },
  // The task API is private; the gateway is its only caller.
  "services": [{ "binding": "API", "service": "runlater-api" }],
  // Hourly: the SECRETS_KEY reseal sweep (src/rotation.ts), idle unless a rotation is on.
  "triggers": { "crons": ["41 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "runlater-gateway", "database_id": "local", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "AUTH_STORE", "class_name": "AuthStore" }] },
  // Hosted MCP: OAuth clients, grants and tokens (workers-oauth-provider).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthStore"] }],
  "ratelimits": [
    { "name": "REGISTER_RATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "OAUTH_RATE", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "MPP_RATE", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "HOOK_RATE", "namespace_id": "1007", "simple": { "limit": 120, "period": 60 } },
    { "name": "HOOK_PROJECT_RATE", "namespace_id": "1009", "simple": { "limit": 600, "period": 60 } },
    { "name": "TOOL_RATE", "namespace_id": "1011", "simple": { "limit": 300, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "runlater-gateway-staging",
      "vars": {
        "PUBLIC_URL": "https://gateway-staging.agentlater.io",
        "HOOKS_URL": "https://hooks-staging.agentlater.io",
        "ALT_PUBLIC_URL": "https://gateway-staging.runlater.io",
        "ALT_HOOKS_URL": "https://hooks-staging.runlater.io",
        "NEW_TRIALS_PER_DAY": "100",
        "A2A_ENABLED": "true"
      },
      // Must match PUBLIC_URL or ALT_PUBLIC_URL: Agent Auth checks token audiences against the one
      // for the request's host (src/hosts.ts). The hooks hosts serve inbound hooks only.
      "routes": [
        { "pattern": "gateway-staging.runlater.io", "custom_domain": true },
        { "pattern": "hooks-staging.runlater.io", "custom_domain": true },
        { "pattern": "gateway-staging.agentlater.io", "custom_domain": true },
        { "pattern": "hooks-staging.agentlater.io", "custom_domain": true }
      ],
      "services": [{ "binding": "API", "service": "runlater-api-staging" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "runlater-gateway-staging", "database_id": "ff3501c9-62a7-44e2-b17a-3b24b7183d1d", "migrations_dir": "migrations" }
      ],
      "durable_objects": { "bindings": [{ "name": "AUTH_STORE", "class_name": "AuthStore" }] },
      "ratelimits": [
        { "name": "REGISTER_RATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "OAUTH_RATE", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
        { "name": "MPP_RATE", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
        { "name": "HOOK_RATE", "namespace_id": "1007", "simple": { "limit": 120, "period": 60 } },
        { "name": "HOOK_PROJECT_RATE", "namespace_id": "1009", "simple": { "limit": 600, "period": 60 } },
        { "name": "TOOL_RATE", "namespace_id": "1011", "simple": { "limit": 300, "period": 60 } }
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "8d9c410b9f39424fb155ca27b542afe0" }]
    },
    "production": {
      "name": "runlater-gateway-production",
      "vars": {
        "PUBLIC_URL": "https://gateway.agentlater.io",
        "HOOKS_URL": "https://hooks.agentlater.io",
        "ALT_PUBLIC_URL": "https://gateway.runlater.io",
        "ALT_HOOKS_URL": "https://hooks.runlater.io",
        "NEW_TRIALS_PER_DAY": "100",
        "A2A_ENABLED": "true"
      },
      "routes": [
        { "pattern": "gateway.runlater.io", "custom_domain": true },
        { "pattern": "hooks.runlater.io", "custom_domain": true },
        { "pattern": "gateway.agentlater.io", "custom_domain": true },
        { "pattern": "hooks.agentlater.io", "custom_domain": true }
      ],
      "services": [{ "binding": "API", "service": "runlater-api-production" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "runlater-gateway-production", "database_id": "73ca0a7b-8022-4d88-aba5-b57bed67ba5a", "migrations_dir": "migrations" }
      ],
      "durable_objects": { "bindings": [{ "name": "AUTH_STORE", "class_name": "AuthStore" }] },
      "ratelimits": [
        { "name": "REGISTER_RATE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "OAUTH_RATE", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
        { "name": "MPP_RATE", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
        { "name": "HOOK_RATE", "namespace_id": "1008", "simple": { "limit": 120, "period": 60 } },
        { "name": "HOOK_PROJECT_RATE", "namespace_id": "1010", "simple": { "limit": 600, "period": 60 } },
        { "name": "TOOL_RATE", "namespace_id": "1012", "simple": { "limit": 300, "period": 60 } }
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d172e7fad1f3452badcbf756685c7abe" }]
    }
  }
}
